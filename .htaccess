RewriteEngine On

# Redirect HTTP -> HTTPS and apex -> www (canonical host) in one hop
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !=www.whoaintfollowingmeback.com [NC]
RewriteRule ^ https://www.whoaintfollowingmeback.com%{REQUEST_URI} [R=301,L]

# Redirect index.html (as typed in the browser) to the root domain
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Redirect /home (as typed in the browser) to the root domain
RewriteCond %{THE_REQUEST} \s/+home/?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Redirect requests for .html (as typed in the browser) to their equivalent
# without extension. Matched against THE_REQUEST (the original request line)
# so this can't re-match after the internal .html rewrite below runs.
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Redirect trailing-slash URLs (except the root) to their non-trailing-slash
# equivalent, again matched against the original request line.
RewriteCond %{THE_REQUEST} \s/+(.+)/[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve the matching .html file for a clean URL, without
# changing the address bar. Must be last: everything above canonicalizes
# the browser-visible URL first, so this internal rewrite never gets
# reprocessed against a redirect rule above it.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*[^/])$ $1.html [L]

<IfModule mod_expires.c>
  ExpiresActive On

  # Images: cache for 1 year
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts: cache for 1 year
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # CSS and JavaScript: cache for 1 month
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"

  # Default (anything else): 1 month
  ExpiresDefault "access plus 1 month"
</IfModule>

# Add Cache-Control headers (extra layer of control)
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>